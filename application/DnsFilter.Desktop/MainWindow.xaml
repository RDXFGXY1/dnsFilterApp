<Window x:Class="DnsFilter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Filter" Width="1160" Height="760" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
  <Grid Background="#050505">
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#080808" BorderBrush="#252525" BorderThickness="0,0,1,0">
      <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,4,0,30"><Border Width="38" Height="38" Background="#172B29" BorderBrush="#3E746D" BorderThickness="1" CornerRadius="9"><TextBlock Text="◇" Foreground="#68D9C8" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="DNS FILTER" FontWeight="Bold" FontSize="15"/><TextBlock Text="WINDOWS CONTROL" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></StackPanel>
          <TextBlock Text="PROTECTION" Foreground="#768196" FontSize="10" FontWeight="Bold" Margin="4,0,0,9"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="▦  Overview" Margin="0,0,0,7" Click="Overview_Click"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="◈  Protection controls" Margin="0,0,0,7" Click="ProtectionControls_Click"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="❄  Connection freeze" Margin="0,0,0,7" Click="Freeze_Click"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="⬡  Hard security" Margin="0,0,0,7" Click="HardSecurity_Click"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="⌁  Live analytics" Margin="0,0,0,7" Click="Analytics_Click"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="⇩  Download Guardian" Margin="0,0,0,7" Click="Downloads_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="LOCAL SERVICE" Foreground="#768196" FontSize="10" FontWeight="Bold"/><TextBlock Text="dnsfilter.localhost:8080" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,3"/><TextBlock x:Name="ProductVersionText" Text="Version" Foreground="#586273" FontSize="10" Margin="0,0,0,12"/><Button Style="{StaticResource GhostButton}" Content="Sign out" Click="SignOut_Click"/></StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="30,24" Background="#050505">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel><TextBlock Text="Protection overview" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Local DNS status and essential controls" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="#163328" BorderBrush="#28684D" BorderThickness="1" CornerRadius="8" Padding="12,8"><TextBlock x:Name="ServiceBadge" Text="● Connecting" Foreground="#82D9A6" FontWeight="SemiBold"/></Border><Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Refresh_Click"/></StackPanel></DockPanel>
      <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#050505">
        <StackPanel x:Name="OverviewSection" Background="#050505">
          <UniformGrid Columns="4">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FILTERING" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="FilteringValue" Text="—" FontSize="26" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="FilteringHint" Text="Checking engine" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SYSTEM DNS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="DnsValue" Text="—" FontSize="26" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="DnsHint" Text="Checking route" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BLOCKED · 24H" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="Blocked24Value" Text="—" FontSize="26" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="Blocked24Hint" Text="Waiting for analytics" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RULE COVERAGE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="BlockedValue" Text="—" FontSize="26" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Domains in blocklists" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
          </UniformGrid>
          <Border x:Name="ProtectionControlsSection" Style="{StaticResource Card}" Margin="0,4,14,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Protection controls" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Turn DNS filtering on or off without leaving the desktop application." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ToggleFilteringButton" Content="Toggle filtering" Click="ToggleFiltering_Click"/><Button Content="System DNS" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="DnsControls_Click"/><Button Content="Clear cache" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ClearCache_Click"/><Button Content="Update lists" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="UpdateLists_Click"/></WrapPanel></Grid></Border>
          <Border x:Name="FreezeSection" Style="{StaticResource Card}" Margin="0,4,14,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Connection freeze" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FreezeStatusText" Text="Checking status…" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="Freeze until stopped" Click="StartFreeze_Click"/><Button Content="Stop freeze" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="StopFreeze_Click"/></WrapPanel></Grid></Border>
          <Grid x:Name="HardSecuritySection" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Border Width="42" Height="42" Background="#112A21" BorderBrush="#28684D" BorderThickness="1" CornerRadius="11"><TextBlock Text="DNS" Foreground="#67D6A0" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="DNS Bypass Kill Switch" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DnsBypassText" Text="Checking firewall enforcement…" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel><TextBlock Grid.Row="1" Text="Stops applications from silently using plaintext DNS outside the local filter." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,17,0,15"/><WrapPanel Grid.Row="2"><Button x:Name="DnsBypassButton" Content="Enable kill switch" Click="ToggleDnsBypass_Click"/><Button Content="Details" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="HardSecurity_Click"/></WrapPanel></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Border Width="42" Height="42" Background="#301719" BorderBrush="#7E343A" BorderThickness="1" CornerRadius="11"><TextBlock Text="Q" Foreground="#F08C94" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="Application Quarantine" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="QuarantineText" Text="Checking isolated applications…" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel><TextBlock Grid.Row="1" Text="Review and release applications whose outbound internet access is fully isolated." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,17,0,15"/><Button Grid.Row="2" Content="Manage quarantine" HorizontalAlignment="Left" Click="HardSecurity_Click"/></Grid></Border>
          </Grid>
          <Border x:Name="NewConnectionsSection" Style="{StaticResource Card}" Margin="0,4,14,14"><StackPanel><DockPanel Margin="0,0,0,13"><StackPanel><TextBlock Text="New connection intelligence" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Untrusted destinations discovered after an application baseline" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right"><TextBlock x:Name="NewConnectionsCount" Text="0 alerts" Foreground="#F2B86B" FontWeight="Bold" HorizontalAlignment="Right"/><Button Content="Show connections" Style="{StaticResource GhostButton}" Margin="0,7,0,0" Click="NewConnections_Click"/></StackPanel></DockPanel><ItemsControl x:Name="NewConnectionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#090909" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Application}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Destination}"/><TextBlock Text="{Binding Reasons}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" BorderBrush="#B14B51" BorderThickness="1" CornerRadius="8" Padding="8,5" HorizontalAlignment="Right"><TextBlock Text="{Binding Risk}" Foreground="#F08C94" FontWeight="Bold"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="AnalyticsSection" Grid.Column="0" Style="{StaticResource Card}">
              <StackPanel><DockPanel><StackPanel><TextBlock Text="Blocked traffic · 24 hours" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Hourly local DNS decisions" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="PeakText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8EA7F5" FontWeight="SemiBold"/></DockPanel><Canvas x:Name="TimelineCanvas" Height="190" Margin="0,18,0,0" Background="#0C0E12" SizeChanged="TimelineCanvas_SizeChanged"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
              <StackPanel><TextBlock Text="Top blocked domains" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Most frequent during the last 24 hours" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,13"/><ItemsControl x:Name="TopDomainsList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Domain}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#2A3150" CornerRadius="6" Padding="8,3" Margin="10,0,0,0"><TextBlock Text="{Binding Count}" Foreground="#AFC0FF" FontWeight="Bold"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Card}" Margin="0,4,14,14">
            <StackPanel><DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="Live blocked activity" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Refreshes every 3 seconds from the local service" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock x:Name="LiveCountText" Foreground="#8EA7F5" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="LastLiveRefreshText" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></DockPanel>
              <DataGrid x:Name="LiveLogGrid" Height="265" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#0C0E12" Foreground="#E9EDF5" BorderBrush="#2B303A" RowBackground="#101318" AlternatingRowBackground="#151922" HorizontalGridLinesBrush="#252B35" ColumnHeaderHeight="34" RowHeight="34">
                <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#191D25"/><Setter Property="Foreground" Value="#AAB4C4"/><Setter Property="BorderBrush" Value="#2B303A"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.Resources>
                <DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="105"/><DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="*"/><DataGridTextColumn Header="CLIENT" Binding="{Binding Client_Ip}" Width="180"/></DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
          <Expander IsExpanded="True" Margin="0,4,14,14" Foreground="#F4F6FA">
            <Expander.Header><StackPanel Margin="0,0,0,12"><TextBlock Text="Advanced protection tools" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Inspect decisions, create quick rules, and review health signals" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel><TextBlock Text="Domain inspector" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Explain the current DNS decision before creating a rule." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DomainInput" Text="example.com" KeyDown="DomainInput_KeyDown"/><Button Grid.Column="1" Content="Inspect" Margin="9,0,0,0" Click="InspectDomain_Click"/></Grid>
                  <Border Background="#0C0E12" BorderBrush="#2B303A" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,14,0,12"><StackPanel><DockPanel><TextBlock x:Name="DecisionDomainText" Text="No domain inspected" FontSize="16" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" Background="#252B3B" CornerRadius="6" Padding="9,4"><TextBlock x:Name="DecisionBadge" Text="READY" Foreground="#AFC0FF" FontWeight="Bold"/></Border></DockPanel><TextBlock x:Name="DecisionReasonText" Text="Enter a domain to see the winning layer and recommendation." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock x:Name="DecisionRecommendationText" Foreground="#C7D2E8" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                  <WrapPanel><Button Content="Block this domain" Click="QuickBlock_Click"/><Button Content="Allow this domain" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="QuickAllow_Click"/></WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                <StackPanel><DockPanel><StackPanel><TextBlock Text="Protection health" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Live checks from the Go service" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="HealthScoreText" DockPanel.Dock="Right" Text="—" FontSize="26" FontWeight="Bold" Foreground="#82D9A6"/></DockPanel>
                  <ItemsControl x:Name="HealthChecksList" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0C0E12" BorderBrush="#2B303A" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StateIcon}" Foreground="{Binding StateColor}" FontSize="17" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <UniformGrid Columns="3" Margin="0,5,0,0"><StackPanel><TextBlock Text="QUERIES" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="HealthQueriesText" Text="—" FontSize="18" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="BLOCKED" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="HealthBlockedText" Text="—" FontSize="18" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="CACHE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="HealthCacheText" Text="—" FontSize="18" FontWeight="Bold"/></StackPanel></UniformGrid>
                </StackPanel>
              </Border>
            </Grid>
          </Expander>
          <Border x:Name="DownloadsSection" Style="{StaticResource Card}" Margin="0,4,14,14"><StackPanel><DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="Download Guardian" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="DownloadsFolderText" Text="Monitoring the Windows Downloads folder" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#112A21" BorderBrush="#28684D" BorderThickness="1" CornerRadius="9" Padding="11,7"><TextBlock Text="● LIVE MONITORING" Foreground="#67D6A0" FontWeight="Bold"/></Border></DockPanel><UniformGrid Columns="5" Margin="0,0,0,16"><Border Background="#090909" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="TODAY" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="DownloadsTodayText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#090909" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="TOTAL" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="DownloadsTotalText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#090909" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="EXECUTABLES" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="DownloadsExecutableText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#090909" BorderBrush="#633337" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,7,0"><StackPanel><TextBlock Text="HIGH RISK" Foreground="#F08C94" FontSize="10"/><TextBlock x:Name="DownloadsRiskText" Text="0" Foreground="#F08C94" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#090909" BorderBrush="#5F4924" BorderThickness="1" CornerRadius="9" Padding="13"><StackPanel><TextBlock Text="QUARANTINED" Foreground="#F2B86B" FontSize="10"/><TextBlock x:Name="DownloadsQuarantineText" Text="0" Foreground="#F2B86B" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid><DataGrid x:Name="DownloadsGrid" Height="285" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="DownloadsGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#090909" Foreground="#F4F6FA" BorderBrush="#292929" RowBackground="#101010" AlternatingRowBackground="#151515" HorizontalGridLinesBrush="#292929"><DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="125"/><DataGridTextColumn Header="FILE" Binding="{Binding Filename}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Detected_Type}" Width="145"/><DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="85"/><DataGridTextColumn Header="SIGNATURE" Binding="{Binding Signature_Status}" Width="105"/><DataGridTextColumn Header="RISK" Binding="{Binding Risk_Score}" Width="65"/><DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="105"/></DataGrid.Columns></DataGrid><Border Background="#090909" BorderBrush="#292929" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DownloadDetailTitle" Text="Select a download to inspect its evidence" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="DownloadDetailText" Text="Hash, signature, type, reasons, and path will appear here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,15,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="QuarantineDownloadButton" Content="Quarantine" Style="{StaticResource DangerButton}" Click="QuarantineDownload_Click" IsEnabled="False"/><Button x:Name="RestoreDownloadButton" Content="Restore" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="RestoreDownload_Click" IsEnabled="False"/></WrapPanel></Grid></Border></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,4,14,14"><StackPanel><TextBlock Text="Activity" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ActivityText" Text="Sign in to load protection status." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border x:Name="LoginLayer" Grid.ColumnSpan="2" Background="#F2090A0D">
      <Grid><Border Width="430" Padding="34" Background="#121419" BorderBrush="#313743" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="DNS Filter" FontSize="28" FontWeight="Bold"/><TextBlock Text="Sign in to the local protection service" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,26"/><TextBlock Text="Username" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/><TextBox x:Name="UsernameBox" Text="admin"/><TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" Margin="0,17,0,7"/><PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown"/><TextBlock x:Name="LoginError" Foreground="#F08C94" Margin="0,12,0,0" TextWrapping="Wrap"/><Button x:Name="LoginButton" Content="Sign in" Margin="0,20,0,0" Click="Login_Click"/><TextBlock Text="The password remains on this computer and is sent only to the local Go service." Foreground="#727E91" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
    </Border>
  </Grid>
</Window>
