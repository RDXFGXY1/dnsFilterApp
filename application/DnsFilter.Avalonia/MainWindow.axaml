<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="DnsFilter.Avalonia.MainWindow"
        Width="1280" Height="800" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Title="DNS Filter">
  <Grid ColumnDefinitions="240,*">
    <Border Grid.Column="0" Background="#050607" BorderBrush="#242932" BorderThickness="0,0,1,0" Padding="18">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="42" Height="42" CornerRadius="11" Background="#102724" BorderBrush="#2C7569" BorderThickness="1"><TextBlock Text="◇" FontSize="25" Foreground="#61E2CB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="DNS FILTER" FontSize="16" FontWeight="Bold"/><TextBlock Text="CROSS-PLATFORM CONTROL" Classes="muted" FontSize="9"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,34,0,0" Spacing="7"><TextBlock Text="PROTECTION" Classes="muted" FontSize="10" FontWeight="Bold" Margin="4,0,0,5"/><Button Classes="nav" Content="▦  Overview" Click="Overview_Click"/><Button Classes="nav" Content="◉  Live activity" Click="Live_Click"/><Button Classes="nav" Content="◈  DNS controls" Click="Controls_Click"/><Button Classes="nav" Content="❄  Connection freeze" Click="Freeze_Click"/><Button Classes="nav" Content="⬡  Hard security" Click="Security_Click"/></StackPanel>
        <StackPanel Grid.Row="2" Spacing="10"><TextBlock x:Name="PlatformText" Classes="muted" FontSize="11"/><Button Content="Sign out" Click="SignOut_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Padding="28,20" BorderBrush="#242932" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel><TextBlock x:Name="PageKicker" Text="PROTECTION OVERVIEW" Classes="kicker"/><TextBlock x:Name="PageTitle" Text="Your network at a glance" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#0F2B20" BorderBrush="#236B4A" BorderThickness="1" CornerRadius="9" Padding="14,8" Margin="0,0,10,0"><TextBlock x:Name="ServiceBadge" Text="● Checking service" Foreground="#69DEA0"/></Border><Button Grid.Column="2" Content="Refresh" Click="Refresh_Click"/></Grid></Border>
      <ScrollViewer Grid.Row="1" Padding="28"><Grid>
        <StackPanel x:Name="OverviewSection" Spacing="16">
          <UniformGrid Columns="4" Rows="1"><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="FILTERING" Classes="muted" FontSize="11"/><TextBlock x:Name="FilteringValue" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,3"/><TextBlock x:Name="FilteringHint" Classes="muted" Text="Waiting for service" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="SYSTEM DNS" Classes="muted" FontSize="11"/><TextBlock x:Name="DnsValue" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,3"/><TextBlock x:Name="DnsHint" Classes="muted" Text="Not checked" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="BLOCKED · 24H" Classes="muted" FontSize="11"/><TextBlock x:Name="Blocked24Value" Text="0" FontSize="25" FontWeight="Bold" Margin="0,10,0,3"/><TextBlock x:Name="Blocked24Hint" Classes="muted" Text="No activity yet"/></StackPanel></Border><Border Classes="card"><StackPanel><TextBlock Text="PROTECTION SCORE" Classes="muted" FontSize="11"/><TextBlock x:Name="HealthScoreText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,10,0,3"/><TextBlock Text="Live readiness checks" Classes="muted"/></StackPanel></Border></UniformGrid>
          <Grid ColumnDefinitions="1.35*,1*" ColumnSpacing="16"><Border Classes="card"><StackPanel><TextBlock Text="Live blocked activity" FontSize="18" FontWeight="Bold"/><TextBlock Text="Automatically refreshes every 3 seconds" Classes="muted" Margin="0,4,0,15"/><DataGrid x:Name="RecentGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="340" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="110"/><DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="*"/><DataGridTextColumn Header="CLIENT" Binding="{Binding Client_Ip}" Width="150"/></DataGrid.Columns></DataGrid></StackPanel></Border><StackPanel Grid.Column="1" Spacing="16"><Border Classes="card"><StackPanel><TextBlock Text="Top blocked domains" FontSize="18" FontWeight="Bold"/><ItemsControl x:Name="TopDomainsList" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,7"><TextBlock Text="{Binding Domain}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#1C2745" CornerRadius="7" Padding="8,3"><TextBlock Text="{Binding Count}" Foreground="#8FAEFF"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Classes="card"><StackPanel><TextBlock Text="Health checks" FontSize="18" FontWeight="Bold"/><ItemsControl x:Name="HealthChecksList" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="28,*" Margin="0,6"><TextBlock Text="{Binding StateIcon}" Foreground="{Binding StateColor}" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></Grid>
        </StackPanel>
        <StackPanel x:Name="LiveSection" IsVisible="False" Spacing="16"><Border Classes="card"><StackPanel><TextBlock Text="Live DNS events" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="LiveStatusText" Text="Waiting for service" Classes="muted" Margin="0,5,0,14"/><DataGrid x:Name="LiveGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="520"><DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="130"/><DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="*"/><DataGridTextColumn Header="CLIENT" Binding="{Binding Client_Ip}" Width="190"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel>
        <StackPanel x:Name="ControlsSection" IsVisible="False" Spacing="16"><Grid ColumnDefinitions="1*,1*" ColumnSpacing="16"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Filtering engine" FontSize="20" FontWeight="Bold"/><TextBlock Text="Enable or disable DNS rule enforcement without stopping the local service." Classes="muted" TextWrapping="Wrap"/><Button x:Name="ToggleFilteringButton" Classes="accent" Content="Change filtering" Click="ToggleFiltering_Click"/><Button Content="Update all blocklists" Click="UpdateLists_Click"/><Button Content="Clear DNS cache" Click="ClearCache_Click"/></StackPanel></Border><Border Grid.Column="1" Classes="card"><StackPanel Spacing="12"><TextBlock Text="System DNS route" FontSize="20" FontWeight="Bold"/><TextBlock Text="Route this computer through the local DNS Filter. Administrator/root permission is required." Classes="muted" TextWrapping="Wrap"/><Button Classes="accent" Content="Enable local DNS" Click="SetupDns_Click"/><Button Content="Restore automatic DNS" Click="ResetDns_Click"/></StackPanel></Border></Grid></StackPanel>
        <StackPanel x:Name="FreezeSection" IsVisible="False" Spacing="16"><Border Classes="card"><StackPanel Spacing="13"><TextBlock Text="Connection Freeze" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="FreezeSupportText" Classes="kicker"/><TextBlock x:Name="FreezeStatusText" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Keep established connections and refuse new outbound connections until you stop it manually." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="StartFreezeButton" Classes="accent" Content="Freeze new connections" Click="StartFreeze_Click"/><Button x:Name="StopFreezeButton" Classes="danger" Content="Stop freeze" Click="StopFreeze_Click"/></StackPanel></StackPanel></Border></StackPanel>
        <StackPanel x:Name="SecuritySection" IsVisible="False" Spacing="16"><Grid ColumnDefinitions="1*,1*" ColumnSpacing="16"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="DNS bypass protection" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="DnsBypassSupportText" Classes="kicker"/><TextBlock x:Name="DnsBypassText" Classes="muted" TextWrapping="Wrap"/><Button x:Name="DnsBypassButton" Classes="accent" Content="Enable protection" Click="ToggleDnsBypass_Click"/></StackPanel></Border><Border Grid.Column="1" Classes="card"><StackPanel Spacing="12"><TextBlock Text="Platform capability" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="CapabilitySummary" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="The interface stays shared. Windows Firewall/WFP features will receive native nftables or Linux telemetry backends next." TextWrapping="Wrap"/></StackPanel></Border></Grid></StackPanel>
      </Grid></ScrollViewer>
    </Grid>
    <Border x:Name="LoginLayer" Grid.ColumnSpan="2" Background="#F207080A"><Border Width="440" Padding="32" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="12"><TextBlock Text="DNS Filter" FontSize="29" FontWeight="Bold"/><TextBlock Text="Sign in to the local protection service" Classes="muted" Margin="0,0,0,10"/><TextBlock Text="Username" Classes="muted"/><TextBox x:Name="UsernameBox" Text="admin"/><TextBlock Text="Password" Classes="muted"/><TextBox x:Name="PasswordBox" PasswordChar="●" KeyDown="PasswordBox_KeyDown"/><TextBlock x:Name="LoginError" Foreground="#F38B93" TextWrapping="Wrap"/><Button x:Name="LoginButton" Classes="accent" Content="Sign in" Click="Login_Click"/><TextBlock Text="Your password stays on this computer and is sent only to the local Go service." Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border></Border>
  </Grid>
</Window>
