[Unit]
Description=DNS Filter local protection service
Documentation=file:/opt/dns-filter/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dns-filter
ExecStart=/opt/dns-filter/dns-filter --config /opt/dns-filter/configs/config.yaml
ExecStopPost=-/usr/bin/nft delete table inet dnsfilter_freeze
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=20
KillSignal=SIGTERM
SuccessExitStatus=0 SIGTERM

# Security settings
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dns-filter

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
