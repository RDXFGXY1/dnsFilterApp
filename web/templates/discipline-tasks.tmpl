{{ define "discipline_tasks" }}
<section class="view" data-view="tasks">
  <div class="view-guide"><div><span class="command-kicker">Execution system</span><strong>Everything you need to do, without the noise</strong><p>Capture, plan, focus, schedule, review, and finish work from one trusted place.</p></div><div class="guide-actions"><button class="ws-tab" onclick="todoOpenTemplates()">Templates</button><button class="ws-tab" onclick="todoRecovery()">Recovery mode</button><button class="ws-tab" onclick="todoShutdown()">Close the day</button></div></div>
  <div class="todo-capture"><input id="todo-capture" placeholder="Capture a task — e.g. Study calculus tomorrow !high #school 45m"><select id="todo-capture-project"><option value="0">Inbox</option></select><button class="btn" onclick="todoCapture()">Add task</button></div>
  <div class="todo-layout"><aside class="todo-rail">
    <button class="active" data-todo-scope="inbox">Inbox <b id="todo-n-inbox">0</b></button><button data-todo-scope="myday">My Day <b id="todo-n-myday">0</b></button><button data-todo-scope="upcoming">Upcoming <b id="todo-n-upcoming">0</b></button><button data-todo-scope="overdue">Overdue <b id="todo-n-overdue">0</b></button><button data-todo-scope="waiting">Waiting <b id="todo-n-waiting">0</b></button><button data-todo-scope="completed">Completed <b id="todo-n-completed">0</b></button><button data-todo-scope="all">All tasks <b id="todo-n-all">0</b></button>
    <div class="todo-rail-divider"></div><span>Projects</span><div id="todo-project-nav"></div>
  </aside><main class="todo-main"><div class="todo-toolbar"><div><span class="command-kicker" id="todo-scope-kicker">Inbox</span><h2 id="todo-scope-title">Unsorted work</h2></div><div class="todo-filters"><input id="todo-search" placeholder="Search tasks"><select id="todo-priority"><option value="">Any priority</option><option>high</option><option>medium</option><option>low</option></select><select id="todo-energy"><option value="">Any energy</option><option>high</option><option>medium</option><option>low</option></select></div></div><div class="todo-summary" id="todo-summary"></div><div class="todo-list" id="todo-list"><span class="no-data">Loading tasks…</span></div></main></div>
  <section class="todo-insights" id="todo-insights"></section>
</section>
<section class="todo-modal" id="todo-editor" hidden><div class="todo-dialog"><div class="panel-head"><div><span class="command-kicker">Task workspace</span><h2 id="todo-editor-title">Task</h2></div><button class="ws-tab" onclick="todoCloseEditor()">Close</button></div><input type="hidden" id="todo-edit-id"><div class="todo-form-grid">
  <label class="wide"><span>Task</span><input id="todo-edit-title"></label><label><span>Project</span><select id="todo-edit-project"></select></label><label><span>Priority</span><select id="todo-edit-priority"><option>high</option><option>medium</option><option>low</option></select></label><label><span>Due date</span><input id="todo-edit-due" type="date"></label><label><span>Time block</span><input id="todo-edit-scheduled" type="datetime-local"></label><label><span>Estimate (minutes)</span><input id="todo-edit-estimate" type="number" min="0"></label><label><span>Energy</span><select id="todo-edit-energy"><option>high</option><option>medium</option><option>low</option></select></label><label><span>Repeat</span><select id="todo-edit-recurrence"><option value="">Never</option><option>daily</option><option>weekdays</option><option>weekly</option><option>monthly</option><option>yearly</option></select></label><label><span>Reminder</span><input id="todo-edit-reminder" type="datetime-local"></label><label class="wide"><span>Tags</span><input id="todo-edit-labels" placeholder="school, deep-work"></label><label class="wide"><span>Notes</span><textarea id="todo-edit-notes"></textarea></label><label class="wide"><span>Waiting for / blocked by</span><input id="todo-edit-waiting" placeholder="Person, response, prerequisite…"></label><label class="wide"><span>Completion evidence</span><textarea id="todo-edit-evidence" placeholder="Link, commit, file path, result, or short proof of completion"></textarea></label>
<label class="wide"><span>Focus protection profile</span><select id="todo-edit-profile"><option value="0">Do not change network protection</option></select></label></div><div class="todo-editor-actions"><button class="btn" onclick="todoSaveEditor()">Save task</button><button class="ws-tab" onclick="todoBreakdown()">Break into steps</button><button class="ws-tab" onclick="todoSaveTemplate()">Save as template</button><button class="ws-tab" onclick="todoStartFocus()">Start Focus</button><button class="btn-remove" onclick="todoDeleteCurrent()">Delete</button></div><div id="todo-checklist" class="todo-checklist"></div><div id="todo-history" class="todo-history"></div></div></section>
<section class="todo-modal" id="todo-template-modal" hidden><div class="todo-dialog todo-template-dialog"><div class="panel-head"><div><span class="command-kicker">Reusable workflows</span><h2>Task templates</h2></div><button class="ws-tab" onclick="todoCloseTemplates()">Close</button></div><div id="todo-template-list"></div></div></section>
{{ end }}
