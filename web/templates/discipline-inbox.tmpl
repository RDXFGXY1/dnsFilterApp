{{ define "discipline_inbox" }}
<section class="view intelligence-inbox" data-view="inbox">
    <div class="view-guide inbox-hero">
        <div><span class="command-kicker">Local intelligence</span><h2>Your system can reach you here</h2><p>Private briefings, warnings, reminders, and useful next actions generated from Discipline data.</p></div>
        <div class="inbox-hero-actions"><button class="ws-tab" onclick="openAIProviders()">AI providers</button><button class="btn" id="inbox-briefing" onclick="generateInboxBriefing()">Generate today’s briefing</button></div>
    </div>
    <div class="inbox-kpis" id="inbox-kpis"></div>
    <div class="inbox-shell">
        <aside class="inbox-folders">
            <button class="active" data-inbox-scope="inbox">Inbox <b id="inbox-folder-total">0</b></button>
            <button data-inbox-scope="unread">Unread <b id="inbox-folder-unread">0</b></button>
            <button data-inbox-scope="starred">Starred <b id="inbox-folder-starred">0</b></button>
            <button data-inbox-scope="archived">Archive <b id="inbox-folder-archived">0</b></button>
            <div class="inbox-privacy"><strong>Private by default</strong><p>Messages stay local. A Discipline snapshot is sent to your selected provider only when you request AI analysis.</p></div>
        </aside>
        <main class="inbox-workspace">
            <div class="inbox-toolbar"><input id="inbox-search" type="search" placeholder="Search messages…"><button class="ws-tab" onclick="loadDisciplineInbox()">Refresh</button></div>
            <div class="inbox-columns">
                <div class="inbox-list" id="inbox-list"><div class="no-data">Loading inbox…</div></div>
                <article class="inbox-reader" id="inbox-reader">
                    <div class="inbox-empty"><span>✦</span><strong>Select a message</strong><p>Open a briefing to read its analysis and next action.</p></div>
                </article>
            </div>
        </main>
    </div>
    <div class="todo-modal" id="ai-provider-modal" hidden>
        <div class="todo-dialog ai-provider-dialog">
            <div class="panel-head"><div><span class="command-kicker">AI connection center</span><h2>Models & providers</h2><p>Keys are encrypted by Secure Vault and never returned to this page.</p></div><button class="ws-tab" onclick="closeAIProviders()">Close</button></div>
            <div class="ai-provider-layout">
                <section><div class="ai-provider-list" id="ai-provider-list"></div></section>
                <section class="ai-provider-form">
                    <input type="hidden" id="ai-provider-id">
                    <label><span>Provider</span><select id="ai-provider-type" onchange="syncAIProviderForm()"><option value="xai">xAI · Grok</option><option value="openai">OpenAI API</option><option value="gemini">Google · Gemini</option><option value="compatible">OpenAI-compatible</option></select></label>
                    <label><span>Connection name</span><input id="ai-provider-name" placeholder="e.g. My Grok account"></label>
                    <label><span>Model</span><input id="ai-provider-model" list="ai-model-suggestions" placeholder="Enter a model available to your account"><datalist id="ai-model-suggestions"><option value="grok-4.7"><option value="gpt-6-astra"><option value="gemini-3.8-flash"></datalist></label>
                    <label id="ai-base-url-row" hidden><span>Base URL</span><input id="ai-provider-base" placeholder="https://provider.example/v1"></label>
                    <label><span>API key</span><input id="ai-provider-key" type="password" autocomplete="new-password" placeholder="Required for a new connection"></label>
                    <label class="ai-provider-toggle"><input id="ai-provider-enabled" type="checkbox" checked><span>Enable this provider</span></label>
                    <label class="ai-provider-toggle"><input id="ai-provider-default" type="checkbox"><span>Use as the default Discipline model</span></label>
                    <div class="ai-provider-note" id="ai-provider-note"></div>
                    <div class="todo-editor-actions"><button class="btn" onclick="saveAIProvider()">Save securely</button><button class="ws-tab" onclick="resetAIProviderForm()">New connection</button></div>
                </section>
            </div>
        </div>
    </div>
</section>
{{ end }}
